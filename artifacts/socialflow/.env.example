# Required: Discord bot token. Store this as a private Replit Secret.
DISCORD_TOKEN=

# Required for slash-command registration.
DISCORD_APPLICATION_ID=

# Optional: set this for instant command updates in one server during development.
# Without it, commands are registered globally and may take time to appear.
DISCORD_GUILD_ID=

# Optional: the health endpoint defaults to port 3000.
PORT=3000